{
  "title": "634HD model overrides",
  "description": "634HD behaviour for particular models, objects, face colours or areas: a material for untextured faces, wind sway, whether they cast shadows.",
  "type": "object",
  "required": ["overrides"],
  "additionalProperties": false,
  "properties": {
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "objects": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "models": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "faceColours": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
          "area": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
          "material": { "type": "integer", "minimum": 0 },
          "wind": { "type": "boolean" },
          "castShadows": { "type": "boolean" }
        }
      }
    }
  }
}
